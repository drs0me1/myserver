# wireguard.command girdisi
#
# Kurulum artık sunucuda tek satırla başlar (DD-228; README):
#   curl -fsSL https://raw.githubusercontent.com/drs0me1/myserver/main/kur.sh | sudo bash
# Alan adı kurulum sırasında sunucuda sorulur. Bu dosyayı yalnız Mac'teki
# wireguard.command okur (SSH ile peer yönetimi).
#
# Kullanım: bu dosyayı repo kökünde kurulum/kurulum.env olarak kopyalayın,
# doldurun ve izinlerini daraltın:
#
#   mkdir -p kurulum && cp Data/config/kurulum.env.example kurulum/kurulum.env
#   chmod 600 kurulum/kurulum.env
#
# Dosya git dışındadır (.gitignore: /kurulum/). Biçim: ALAN=değer, tırnaksız.

# SSH ile bağlanılacak sunucu (~/.ssh/config'teki ad).
SSH_HOST=
