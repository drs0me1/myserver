def read_env(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                key, sep, value = line.rstrip("\n").partition("=")
                if sep and re.match(r"^[A-Z][A-Z0-9_]*$", key):
                    if len(value) >= 2 and value[0] == value[-1] == '"':
                        value = value[1:-1]
                    out[key] = value
    except OSError:
        pass
    return out



