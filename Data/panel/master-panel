def clean_layout(value):
    """DD-206: the overview layout as stored; ValueError (Turkish, for the operator) when malformed."""
    if not isinstance(value, dict) or not set(value) <= {"schema", "kareler", "widgetlar"} or value.get("schema", 1) != 1:
        raise ValueError("Düzen kaydı geçersiz.")
    tiles, widgets = value.get("kareler", []), value.get("widgetlar", [])
    if (not isinstance(tiles, list) or len(tiles) > LAYOUT_MAX_TILES or len(set(map(str, tiles))) != len(tiles)
            or not all(isinstance(k, str) and LAYOUT_KEY_RE.fullmatch(k) for k in tiles)):
        raise ValueError("Kare sırası geçersiz.")
    if not isinstance(widgets, list) or len(widgets) > LAYOUT_MAX_WIDGETS:
        raise ValueError("Widget listesi geçersiz.")
    seen, clean = set(), []
    for item in widgets:
        if (not isinstance(item, dict) or set(item) != {"id", "genislik", "gizli"} or not isinstance(item["id"], str)
                or not LAYOUT_KEY_RE.fullmatch(item["id"]) or item["id"] in seen
                or type(item["genislik"]) is not int or item["genislik"] not in LAYOUT_SPANS or type(item["gizli"]) is not bool):
            raise ValueError("Widget ayarı geçersiz.")
        seen.add(item["id"])
        clean.append({"id": item["id"], "genislik": item["genislik"], "gizli": item["gizli"]})
    return {"schema": 1, "kareler": list(tiles), "widgetlar": clean}


def own_address(ip):
    """Sunucunun kendi adresi mi? Sıradan bir soket yalnız yerel bir adrese bağlanabilir.
    Yalnız "adres yerel değil" (EADDRNOTAVAIL) dışarıdan sayılır; başka her hata (port ya da
    dosya tanıtıcısı tükenmesi) isteği reddettirir. Port ayrılmaz: IP_BIND_ADDRESS_NO_PORT."""
    if ip.is_loopback or ip.is_link_local or ip.is_unspecified:
        return True
    try:
        with socket.socket(socket.AF_INET6 if ip.version == 6 else socket.AF_INET, socket.SOCK_STREAM) as probe:
            with contextlib.suppress(OSError):
                probe.setsockopt(socket.IPPROTO_IP, getattr(socket, "IP_BIND_ADDRESS_NO_PORT", 24), 1)
            probe.bind((str(ip), 0))
    except OSError as err:
        return err.errno != errno.EADDRNOTAVAIL
    return True


def remote_tailnet(value):
    try:
        ip = ipaddress.ip_address(value)
    except ValueError:
        return False
    ip = getattr(ip, "ipv4_mapped", None) or ip
    return any(ip in net for net in TAILNET_RANGES) and not own_address(ip)


def fail(msg, code=1):
    print("HATA: " + msg, file=sys.stderr)
    sys.exit(code)


class UnixConnection(http.client.HTTPConnection):
    """check --socket: Caddy'yi atlayıp arka ucun kendi soketine sorar (kurulum, testler)."""
    def __init__(self, path, timeout):
        super().__init__("localhost", timeout=timeout)
        self.socket_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.socket_path)


def cmd_check(args):
    headers = {"Host": args.host, API_HEADER: "1"}
    try:
        if args.socket:
            conn = UnixConnection(args.socket, 15)
            try:
                conn.request("GET", urllib.parse.urlsplit(args.url).path or "/", headers=headers)
                resp = conn.getresponse()
                body = resp.read()
            finally:
                conn.close()
            if resp.status != 200:
                fail("panel HTTP %d verdi" % resp.status)
            data = json.loads(body.decode())
        else:
            req = urllib.request.Request(args.url, headers=headers)
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode())
    except urllib.error.HTTPError as err:
        fail("panel HTTP %d verdi" % err.code)
    except (urllib.error.URLError, http.client.HTTPException, ValueError, OSError, RecursionError) as err:
        fail("panel yanıt vermedi (%s)" % err)
    # DD-196/200: kurulumun yoklaması paketten bağımsız sistem uç noktasıdır; başka yol yok.
    if not isinstance(data, dict) or not isinstance(data.get("version"), str) \
            or not isinstance(data.get("read_at"), (int, float)):
        fail("panel yanıtı beklenen biçimde değil")
    print("sürüm %s" % data["version"])


