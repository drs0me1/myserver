def manifest_ports(manifest):
    """PAKET_PORTLAR entries "KEY:proto:scope:name" separated by ';'; malformed entries are skipped."""
    rows = []
    for entry in (manifest.get("PAKET_PORTLAR") or "").split(";"):
        parts = entry.strip().split(":", 3)
        if len(parts) != 4:
            continue
        key, proto, scope, name = (part.strip() for part in parts)
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key) or proto not in ("tcp", "udp", "udp+tcp") or scope not in PORT_SCOPES or not name:
            continue
        rows.append((key, name, proto, scope))
    return rows


