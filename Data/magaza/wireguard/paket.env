# WireGuard paketi (DD-150, DD-196, DD-197). Mağaza motoru (master-modul) bu bildirimi okur;
# adımlar kanca dosyasındadır. Yalnız PAKET_* anahtarları; değerler tırnaklı ya da düz.
PAKET_AD="WireGuard"
PAKET_SIRA=10
PAKET_CALISMA=konsol
PAKET_DURDURULABILIR=1
PAKET_HESAP=0
PAKET_APT="wireguard-tools qrencode"
PAKET_ARACLAR="master-wg"
PAKET_EKLER="wg-quick-master-stack.conf:wg-quick@.service.d/master-stack.conf"
PAKET_ADLAR=0
PAKET_GUNLUK="wg-quick@*"
PAKET_KUR_ADIM=5
PAKET_UYGULA_HEP=1
PAKET_UYGULA_NEDEN="paketler, çekirdek modülü, ağlar, Konsol sayfası"
# DD-200: Konsol. App Store metinleri ve sayfa bildirimi; sayfa dosyaları kuruluyken
# CONSOLE_WEB_DIR/uygulama/wireguard/ altına konur; API modülünü root arka uç paket
# klasöründen yükler (/api/uygulama/wireguard/*).
PAKET_KONSOL="konsol.json"
PAKET_SAYFA="sayfa.js sayfa.css"
PAKET_API="api.py"
# DD-203: root arka ucun (paket API'si master-wg'yi çalıştırır) yazabileceği yol; kurulum bunu
# master-panel biriminin ReadWritePaths satırına '-' ile ekler (yoksa atlanır).
PAKET_ARKAUC_YOLLAR="__WG_CONF_DIR__"
# DD-206: Genel bakış → Ağ kartındaki toplamlar; ağların arayüz sayaçlarını trafik.py okur.
PAKET_TRAFIK="trafik.py"
