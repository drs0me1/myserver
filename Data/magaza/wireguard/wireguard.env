# WireGuard paketinin kendi ayarları (DD-201). Kurulum bu dosyayı olduğu gibi
# MODULES_DIR/wireguard/ altına koyar; master-wg, paket kancaları ve Konsol API modülü
# buradan okur. Temel (state.env, defaults.env) bu anahtarları tanımaz. Hiçbiri kurulu bir
# ağı anlatmaz: ağın adresi de portu da kayıt satırında yaşar (DD-143).
# İlk ağa önerilen UDP portu; yalnız Konsol'un önerisidir, ağı ve portunu master-wg net-add doğrular.
WG_PORT_DEFAULT="61001"
# Adres tabanı (DD-135): wgN ağı BASE4.N.0/24 ve BASE6::N:0/112 alır, sunucu .1; istemci IPv6
# adresi sunucununkiyle aynı önekte, yalnız son grubu farklıdır.
WG_ADDR_BASE4="10.8"
WG_ADDR_BASE6="fdcc:ad94:bacf:61a4"
WG_MTU="1420"
# Cihaz profili varsayılanları (DD-124). DNS (DD-131): Cloudflare, önce IPv4 — nrm'den ölçümde
# IPv6 cevaplarının yarısı 12 ms'yi aştı; IPv6 yedek olarak üçüncü sırada. AllowedIPs her
# profilde aynı (tam tünel). Konsol ve wireguard.command da bu varsayılanları gösterir.
WG_CLIENT_DNS_DEFAULT="1.1.1.1, 1.0.0.1, 2606:4700:4700::1001"
WG_CLIENT_KEEPALIVE_DEFAULT="21"
WG_CLIENT_ALLOWED_IPS="0.0.0.0/0, ::/0"
# Her ağın yapılandırması WG_CONF_DIR/wgN.conf, profilleri WG_CLIENTS_DIR-wgN (DD-143):
# ikisi de ad tabanıdır, tek bir ağa işaret etmez.
WG_CONF_DIR="/etc/wireguard"
WG_CLIENTS_DIR="/etc/wireguard/clients"
# Ağ kaydı (DD-136, DD-143): wg0…wg9, hepsi Konsol'dan kurulur. Kayıt satırı (sekmeyle): arayüz,
# UDP portu, sabit inet alanı (DD-177), sunucu IPv4, alt ağ IPv4, sunucu IPv6, alt ağ IPv6,
# varsayılan DNS, etiket. master-wg yazar; paketin güvenlik duvarı bildirimi, sağlık kancası ve
# API modülü okur; kayıtta olmayan ağ yoktur, wg0 dahil.
WG_NETWORKS_FILE="/etc/wireguard/networks"
# DD-229: WireGuard bütünüyle durdurulunca (Ana Menü / App Store → Durdur) o an açık olan ağların
# listesi. Varken master-wg ağ açmaz ve yeni ağ eklemez; Başlat listedeki ağları açar ve dosyayı siler.
WG_STOPPED_FILE="/etc/wireguard/.durduruldu"
WG_NETWORKS_MAX="9"
WG_MODULES_LOAD_FILE="/etc/modules-load.d/master-stack-wireguard.conf"
