# Yerleşik Dosyalar (dosya, DD-139/159). Birimi kurulum systemd/master-files-panel.service
# şablonundan bu klasöre işler; master-modul yerlesik yerleştirir. Katalogda görünmez (DD-197).
PAKET_AD="Dosya yöneticisi"
PAKET_SIRA=80
PAKET_CALISMA=host
PAKET_YERLESIK=1
PAKET_PORTLAR="FILES_PANEL_PORT:tcp:loopback:Konsol · dosya arka ucu"
