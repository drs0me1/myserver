# qBittorrent paketinin kendi ayarları (DD-203). Kurulum bu dosyayı paket klasörüne kopyalar ve
# paketin şablonlarındaki __TORRENT_*__ yer tutucularını buradan doldurur; kanca, api.py,
# ayar.py, yayin.py ve klasorler.py onu okur. Taban (defaults.env/state.env) bu anahtarları taşımaz.
# Web arayüzü yalnız 127.0.0.1'de yayımlanır; tailnet'ten erişim Caddy üzerinden (torrent.<alan>).
# DD-219: arayüz ve eş portu, 610xx bloğundan uzak, bilinen hizmetlerle çakışmayan sabit seyrek portlardır;
# Linux'un giden bağlantı aralığının (32768–60999) dışındadır.
TORRENT_UI_PORT=62947
# DD-217: eş (peer) portu sabittir ve yalnız sunucunun WAN IPv4 adresinde TCP+UDP yayımlanır; DHT ve
# uTP aynı portu kullanır. Konteyner bu ağa (adı aşağıda, köprüsü Konsol korumasının önekiyle) bağlıdır.
TORRENT_PEER_PORT=63851
TORRENT_NETWORK=torrent
# Profil (ayarlar, torrent listesi; konteynerde /config); indirme hesabına aittir, `kaldir --veri` siler.
TORRENT_PROFILE_DIR=/var/lib/qbittorrent
# DD-209: konteynerin adı (birimi AD.service) ve imajı. İmaj yalnız özetiyle yazılır (çoklu mimari
# dizini: amd64 ve arm64); bu, temiz kurulumun test edilmiş sürümüdür. DD-214: Konsol, kanalın
# (TORRENT_IMAGE_KANAL) şu an gösterdiği özeti denetler; operatör onaylarsa yeni özet kalıcı seçim
# olur (package-overrides) ve Quadlet dosyası onu gösterir. Kendiliğinden güncelleme yoktur.
# TORRENT_SURUM yalnız App Store metnidir: imajın sürüm etiketi (org.opencontainers.image.version).
TORRENT_CONTAINER=qbittorrent
TORRENT_SURUM=5.2.4_v2.0.15-ls479
TORRENT_IMAGE=lscr.io/linuxserver/qbittorrent@sha256:b522f9f4b769f8f36d49d22d5eb6a92e9aa18904c6a1830b1439df511ec21983
TORRENT_IMAGE_KANAL=lscr.io/linuxserver/qbittorrent:latest
