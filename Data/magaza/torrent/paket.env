# qBittorrent paketi (DD-151, DD-197, DD-209). Mağaza motoru (master-modul) bu bildirimi okur;
# adımlar kanca dosyasındadır. Yalnız PAKET_* anahtarları; değerler tırnaklı ya da düz.
# Tabandaki Podman'da konteyner olarak çalışır: birimi qbittorrent.container (quadlet), imajı
# torrent.env'deki özetiyle sabit TORRENT_IMAGE. Debian paketi yok.
PAKET_AD="qBittorrent"
PAKET_SIRA=20
PAKET_CALISMA=konteyner
PAKET_DURDURULABILIR=1
PAKET_HESAP=1
# DD-210: Konsol'daki kurulum penceresi (hesap ve indirme klasörü). Taban kurmadan önce bu çalışanla
# (kur-hazirla) doğrular; kanca seçimleri konteynerin ilk açılışından önce profile yazar (kur-uygula).
PAKET_KUR_AYAR="ayar.py"
# Konteynerler düzenleyicisi; profil/hesap bu genel forma açılmaz.
PAKET_KONTEYNER_YONETIM="ayar.py"
# DD-214: Konsol'da onaylanan imaj güncellemesi de kalıcı seçimdir (kurulum şablonları ondan doldurur).
# DD-221: Podman sayfasında değiştirilen eş portu da öyle.
PAKET_AYAR_ANAHTARLAR="TORRENT_UI_PORT TORRENT_PEER_PORT TORRENT_IMAGE"
PAKET_APT=""
PAKET_ARACLAR=""
PAKET_EKLER=""
PAKET_KONTEYNER="qbittorrent.container"
# DD-217: konteynerin kendi köprü ağı. Motor yoksa kurar; Konsol'un yönlendirme koruması bu köprüye yalnız
# Quadlet dosyasının yayımladığı WAN/Tailscale portlarını geçirir.
PAKET_KONTEYNER_AG="__TORRENT_NETWORK__"
PAKET_IMAJ="__TORRENT_IMAGE__"
# DD-214: imajın izlediği kanal (hareketli etiket). Konsol yalnız denetler; güncelleme açık istektir.
PAKET_IMAJ_KANAL="__TORRENT_IMAGE_KANAL__"
PAKET_ADLAR=1
PAKET_GUNLUK=""
PAKET_KUR_ADIM=4
# DD-199: Ayarlar → Caddy yayın satırı. Upstream yalnız loopback olabilir; denetim modülü bu
# klasördedir ve uygulamanın kendi girişini şart koşar.
PAKET_YAYIN=1
PAKET_YAYIN_AD="qBittorrent"
PAKET_YAYIN_YEREL="torrent"
PAKET_YAYIN_UPSTREAM="127.0.0.1:__TORRENT_UI_PORT__"
PAKET_YAYIN_PORT_ANAHTARI="TORRENT_UI_PORT"
PAKET_YAYIN_DENETIM="yayin.py"
PAKET_UYGULA_HEP=0
# DD-200/202: Konsol. App Store metinleri ve sayfa bildirimi; sayfa dosyaları kuruluyken
# CONSOLE_WEB_DIR/uygulama/torrent/ altına konur; API modülü (hesap, indirme dizini, durum)
# root arka uçta çalışır ve değişiklikleri paketin ayar.py çalışanına verir.
PAKET_KONSOL="konsol.json"
PAKET_SAYFA="sayfa.js sayfa.css"
PAKET_API="api.py"
# DD-198/203: Ayarlar port kataloğu satırı: anahtar (state ya da paketin torrent.env dosyasından),
# protokol, kapsam, ad (";" ile birden çok).
PAKET_PORTLAR="TORRENT_UI_PORT:tcp:loopback:qBittorrent arayüzü;TORRENT_PEER_PORT:udp+tcp:internet:qBittorrent eş portu"
# DD-203: paketin yazdığı klasörler (mutlak yol). Dosyalar seçtirmez/paylaştırmaz, WebDAV gizler,
# paylaşım açılamaz. Kullanıcının qBittorrent'te seçtiği geçici klasörü klasorler.py bildirir.
PAKET_KLASORLER="__DOWNLOADS_PATH__/incomplete"
PAKET_KLASOR_MODUL="klasorler.py"
# DD-206: Genel bakış → Ağ kartındaki toplamlar; qBittorrent'in kendi "tüm zamanlar" kaydını trafik.py okur.
PAKET_TRAFIK="trafik.py"
