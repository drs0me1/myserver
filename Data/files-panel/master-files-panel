def disk_room(fd, incoming=0):
    """Yazmadan önce ve yazarken: dosya sistemi ayrılan boş alanın altına inmesin (DD-180)."""
    st = os.fstatvfs(fd)
    reserve = min(DISK_RESERVE, st.f_blocks * st.f_frsize // DISK_RESERVE_DIVISOR)
    if st.f_bavail * st.f_frsize - incoming < reserve:
        raise PanelError(507, "sunucuda yeterli boş alan yok (en az %.1f GB boş kalmalı)" % (reserve / 1024 ** 3))


def cmd_check(args):
    req = urllib.request.Request(args.url, headers={"Host": args.host, API_HEADER: "1"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode())
    except urllib.error.HTTPError as err:
        fail("panel HTTP %d verdi" % err.code)
    except (urllib.error.URLError, ValueError, OSError) as err:
        fail("panel yanıt vermedi (%s)" % err)
    if not isinstance(data, dict):
        fail("panel yanıtı beklenen biçimde değil")
    trash = data.get("trash")
    if data.get("sistem") is True and isinstance(data.get("root"), str) and data.get("writable"):
        print("sistem görünümü, kök %s" % data["root"])  # DD-235: çöpü yok
        return
    if not isinstance(data.get("root"), str) or not isinstance(trash, dict) or not data.get("writable"):
        fail("panel yanıtı beklenen biçimde değil ya da kök yazılamıyor")
    print("kök %s, çöpte %d öge" % (data["root"], trash.get("count", 0)))


