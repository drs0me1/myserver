def report_archive(job):
    """DD-183: arşiv işinin sonucu, isteğin audit satırıyla aynı biçimde Günlük'e düşer.
    İş arka planda biter; istemci adresi yoktur ("-")."""
    ok = job.get("status") in ("done", "skipped", "cancelled")
    detail = "%s → %s: %s" % (job_source(job), job.get("name", ""), job.get("message", ""))
    print("dosya: %s - arsiv-sonuc %s -> %s" % (ACTOR, json.dumps(detail, ensure_ascii=False), "ok" if ok else "hata"),
          flush=True)


class Panel:
    def __init__(self, args):
        self.args = args
        self.lock = threading.Lock()
        self.usage_cache = (0.0, None)
        self.system = bool(getattr(args, "sistem", False))
        self.files = Files(args.root, args.trash, args.share, getattr(args, "archive_dir", ""), system=self.system)
        self.archives = None if self.system else (Archives(self.files, self.files.archive, rename_noreplace, rmtree_at, report=report_archive)
                         if self.files.archive else None)

    def used(self):
        """İndirilenlerin toplamı; ağaç yürüyüşü USAGE_CACHE_SECONDS boyunca önbellekte."""
        now = time.time()
        stamp, value = self.usage_cache
        if now - stamp < USAGE_CACHE_SECONDS:
            return value
        try:
            value = self.files.used()
        except OSError:
            value = None
        self.usage_cache = (now, value)
        return value

    def state(self):
        vfs = os.statvfs(self.args.root)
        if self.system:
            # DD-235: çöp, kullanım toplamı ve paket klasörleri yok (DD-238: salt okunur kök de yok).
            return {
                "host": socket.gethostname(),
                "version": self.args.version,
                "root": self.args.root,
                "sistem": True,
                "writable": os.access(self.args.root, os.W_OK),
                "disk": {"total": vfs.f_blocks * vfs.f_frsize, "free": vfs.f_bavail * vfs.f_frsize,
                         "used": None, "mount": True},
                "textLimit": TEXT_LIMIT,
            }
        items = self.files.trash_items()
        return {
            "host": socket.gethostname(),
            "version": self.args.version,
            "root": self.args.root,
            "downloads": getattr(self.args, "downloads_dir", ""),
            "domain": self.args.domain,
            "protected": self.args.protected,
            "writable": os.access(self.args.root, os.W_OK),
            "disk": {"total": vfs.f_blocks * vfs.f_frsize, "free": vfs.f_bavail * vfs.f_frsize,
                     "used": self.used(), "mount": os.path.ismount(self.args.root)},
            "trash": {"count": len(items), "size": sum(i["size"] or 0 for i in items)},
            "textLimit": TEXT_LIMIT,
        }


class Handler(http.server.BaseHTTPRequestHandler):
    panel = None
    server_version = "master-files-panel"
    sys_version = ""
    protocol_version = "HTTP/1.1"
    # DD-181: Caddy keeps this loopback connection alive; with Nagle every reply waited
    # ~40 ms for the peer's delayed ACK (headers and body are separate writes).
    disable_nagle_algorithm = True
    # Caddy's default upstream keepalive is 120s; expire idle sockets after it.
    # This is inactivity, not a deadline for a progressing upload/download.
    timeout = 180

    def log_message(self, fmt, *args):  # istek satırları yazılmaz; değişiklikler audit ile
        pass

    def audit(self, user, action, detail, ok):
        print("dosya: %s %s %s %s -> %s" % (user, self.client(), action,
                                             json.dumps(detail, ensure_ascii=False), "ok" if ok else "hata"), flush=True)

    def client(self):
        peer = self.client_address[0] if self.client_address else "?"
        forwarded = self.headers.get("X-Forwarded-For", "") if self.headers else ""
        if (peer in ("127.0.0.1", "::1") or self.panel.system) and forwarded:
            return forwarded.split(",")[-1].strip()[:64]
        return peer

    def security_headers(self):
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy", CSP)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")

    def send(self, code, body=b"", ctype="application/json; charset=utf-8", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.security_headers()
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def json(self, code, obj):
        self.send(code, json.dumps(obj, ensure_ascii=False))

    def error(self, code, message):
        # Okunmamış bir istek gövdesi bağlantıda kalmasın: hatadan sonra bağlantı kapanır.
        self.close_connection = True
        self.json(code, {"error": message})

    def allowed_hosts(self):
        if self.panel.system:
            hosts = set()  # DD-235: yalnız Caddy'den (Unix soketi), panel.<alan> adıyla
        else:
            port = self.server.server_address[1]
            hosts = {"127.0.0.1:%d" % port, "localhost:%d" % port}
        if self.panel.args.domain:
            hosts.add("panel.%s" % self.panel.args.domain.lower())
        hosts.update(h.lower() for h in self.panel.args.allow_host)
        return hosts

    def gate(self, route):
        """Host ve API için köken denetimi. İşlemi yapanın günlük adı ya da None (yanıt gönderildi).
        DD-194: oturumu Caddy denetler; bu iki denetim oturumdan bağımsız kalır."""
        host = (self.headers.get("Host") or "").lower()
        if host not in self.allowed_hosts():
            self.error(403, "bu adresten erişilemez")
            return None
        if self.panel.system:
            # DD-235: root dosya yetkisi yalnız Tailscale sitesinden ve başka bir Tailscale cihazından.
            # İki başlığı da Caddy yazar (istemcininkini ezer); internet sitesi bu yolu hiç yönlendirmez.
            forwarded = self.headers.get("X-Forwarded-For", "")
            if (self.headers.get(CHANNEL_HEADER) != "tailscale"
                    or not remote_tailnet(forwarded.split(",")[-1].strip())):
                self.error(403, "Sistem görünümü yalnız başka bir Tailscale cihazından kullanılır")
                return None
        if route.startswith("/api/"):
            site = self.headers.get("Sec-Fetch-Site")
            # İndirme bir bağlantıyla açılır (özel başlık gönderilemez); yalnız okur, yine de
            # başka bir siteden gelen istek reddedilir.
            header_ok = route == "/api/download" or self.headers.get(API_HEADER) == "1"
            if not header_ok or (site and site not in ("same-origin", "none")):
                self.error(403, "istek reddedildi (yalnız panel sayfasından)")
                return None
        return SYSTEM_ACTOR if self.panel.system else ACTOR

    def route_of(self):
        """İsteğin yolu. DD-235: sistem kipinde yollar /api/sistem/* altındadır; içeride /api/* olur."""
        route = urllib.parse.urlsplit(self.path).path
        if not self.panel.system:
            return route
        if not route.startswith(SYSTEM_PREFIX + "/"):
            return "/"
        return "/api" + route[len(SYSTEM_PREFIX):]

    def body_json(self, limit=MAX_BODY):
        if (self.headers.get("Content-Type") or "").split(";")[0].strip() != "application/json":
            return None
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length <= 0 or length > limit:
            return None
        try:
            data = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError, RecursionError):
            return None
        return data if isinstance(data, dict) else None

    # -- yardımcılar
    def names(self, data, key="names"):
        names = data.get(key)
        if (not isinstance(names, list) or not names or len(names) > MAX_NAMES
                or not all(valid_name(n) for n in names) or len(set(names)) != len(names)):
            raise PanelError(400, "geçersiz öge listesi")
        return names

    def ids(self, data):
        ids = data.get("ids")
        if (not isinstance(ids, list) or not ids or len(ids) > MAX_NAMES
                or not all(isinstance(i, str) and TOKEN_RE.match(i) for i in ids) or len(set(ids)) != len(ids)):
            raise PanelError(400, "geçersiz çöp kaydı")
        return ids

    def run(self, user, action, fn, lock, hint=""):
        try:
            if lock:
                with self.panel.files.lock:
                    code, result, detail = fn()
            else:
                code, result, detail = fn()
        except (PanelError, ArchiveError) as err:
            if action:
                self.audit(user, action, "%s: %s" % (hint, err.message), False)
            self.error(err.code, err.message)
            return
        except OSError as err:
            if action:
                self.audit(user, action, "%s: %s" % (hint, os_message(err)), False)
            self.error(status_for(err), os_message(err))
            return
        if action:
            self.audit(user, action, detail, True)
        self.json(code, result)

    # -- yöntemler
    def do_GET(self):
        split = urllib.parse.urlsplit(self.path)
        route = self.route_of()
        user = self.gate(route)
        if user is None:
            return
        query = urllib.parse.parse_qs(split.query, keep_blank_values=True)
        arg = lambda key: (query.get(key) or [""])[0]
        files = self.panel.files
        if route == "/api/state":
            self.run(user, None, lambda: (200, self.panel.state(), None), lock=False)
        elif route == "/api/archives" and self.panel.archives:
            self.run(user, None, lambda: (200, self.panel.archives.status(), None), lock=False)
        elif route == "/api/list":
            self.run(user, None, lambda: (200, files.listing(files.split(arg("path")), arg("dirs") == "1"), None),
                     lock=False)
        elif route == "/api/trash" and not self.panel.system:
            self.run(user, None, lambda: (200, {"items": files.trash_items()}, None), lock=False)
        elif route == "/api/text":
            self.run(user, None, lambda: (200, files.text(files.split(arg("path")), arg("enc") or "auto"), None),
                     lock=False)
        elif route == "/api/download":
            self.download(user, arg("path"))
        else:
            self.error(404, "bulunamadı")

    def do_HEAD(self):
        self.do_GET()

    def upload(self, user):
        """POST /api/upload?path=<klasör>&name=<ad> — gövde dosyanın kendisidir (DD-145)."""
        query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        raw_path = (query.get("path") or [""])[0]
        name = (query.get("name") or [""])[0]
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length <= 0:
            self.error(411, "yükleme için Content-Length gerekir")
            return
        if length > UPLOAD_MAX_BYTES:
            self.error(413, "dosya çok büyük (en çok %d GB)" % (UPLOAD_MAX_BYTES // (1024 ** 3)))
            return
        files = self.panel.files
        try:
            parts = files.split(raw_path)
            files.upload_check(parts, name, length)
        except (PanelError, OSError) as err:
            # Yanıt gövde okunmadan giderse bağlantı sıfırlanır ve istemci 502 görür.
            self.drain(length)
            code, message = (err.code, err.message) if isinstance(err, PanelError) else (status_for(err), os_message(err))
            self.audit(user, "yükle", "%s: %s" % (name, message), False)
            self.error(code, message)
            return

        def put():
            written = files.upload(parts, name, self.rfile, length)
            return 201, {"name": name, "size": written}, "/".join(parts + [name])

        self.run(user, "yükle", put, lock=False, hint=name)

    def drain(self, length):
        """İstek gövdesini okuyup atar (en çok UPLOAD_DRAIN_MAX); daha büyüğü bağlantıyı kapatır."""
        if length > UPLOAD_DRAIN_MAX:
            return
        left = length
        try:
            while left > 0:
                chunk = self.rfile.read(min(UPLOAD_CHUNK, left))
                if not chunk:
                    break
                left -= len(chunk)
        except OSError:
            pass

    def download(self, user, raw):
        files = self.panel.files
        try:
            parts = files.split(raw)
            fd, st = files.open_file(parts)
        except PanelError as err:
            self.error(err.code, err.message)
            return
        except OSError as err:
            self.error(status_for(err), os_message(err))
            return
        name = parts[-1]
        fallback = re.sub(r"[^A-Za-z0-9._ -]", "_", name) or "dosya"
        with os.fdopen(fd, "rb") as fh:
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Length", str(st.st_size))
            self.send_header("Content-Disposition", "attachment; filename=\"%s\"; filename*=UTF-8''%s"
                             % (fallback, urllib.parse.quote(name, safe="")))
            self.security_headers()
            self.end_headers()
            self.audit(user, "indir", "/".join(parts), True)
            if self.command == "HEAD":
                return
            remaining = st.st_size
            try:
                while remaining > 0:
                    chunk = fh.read(min(1 << 20, remaining))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    remaining -= len(chunk)
            except (BrokenPipeError, ConnectionResetError, TimeoutError):
                self.close_connection = True
            if remaining:
                self.close_connection = True

    def do_POST(self):
        route = self.route_of()
        user = self.gate(route)
        if user is None:
            self.close_connection = True
            return
        if route == "/api/upload":
            self.upload(user)
            return
        data = self.body_json(TEXT_BODY_MAX if route == "/api/text/save" else MAX_BODY)
        if data is None:
            self.error(400, "istek gövdesi JSON olmalı")
            return
        files = self.panel.files

        if route in ("/api/archives", "/api/archives/cancel") and self.panel.archives:
            submit = route == "/api/archives"

            def archive_action():
                manager = self.panel.archives
                job = manager.submit(data) if submit else manager.cancel(data.get("id"))
                # DD-183: readable in Günlük; the result follows as "arsiv-sonuc".
                return 202, {"job": job}, "%s → %s" % (job_source(job), job["name"])
            action = ("arsiv-olustur" if data.get("operation") == "zip" else "arsiv-ac") if submit else "arsiv-iptal"
            names = data.get("names") if isinstance(data.get("names"), list) else []
            hint = "%s → %s" % (", ".join(str(n) for n in names[:3])[:200], str(data.get("name", ""))[:200]) if submit else ""
            self.run(user, action, archive_action, lock=False, hint=hint)
            return

        def mkdir():
            parts, name = files.split(data.get("path")), data.get("name")
            files.mkdir(parts, name)
            return 201, {"name": name}, "/".join(parts + [name])

        def rename():
            parts, name, new = files.split(data.get("path")), data.get("name"), data.get("to")
            files.rename(parts, name, new)
            return 200, {"name": new}, "%s -> %s" % ("/".join(parts + [str(name)]), new)

        def move():
            parts, names, dest = files.split(data.get("path")), self.names(data), files.split(data.get("to"))
            moved = files.move(parts, names, dest)
            return 200, {"moved": moved}, "%s %s -> %s" % ("/".join(parts), names[:5], "/".join(dest))

        def trash():
            parts, names = files.split(data.get("path")), self.names(data)
            ids = files.to_trash(parts, names)
            return 200, {"ids": ids}, "%s %s" % ("/".join(parts), names[:5])

        def restore():
            ids = self.ids(data)
            done = files.restore(ids)
            return 200, {"restored": done}, ids[:5]

        def purge():
            ids = self.ids(data)
            files.purge(ids)
            return 200, {"purged": len(ids)}, ids[:5]

        def empty():
            if str(data.get("confirm", "")).strip().lower() != CONFIRM_WORD:
                raise PanelError(400, "onay için %s yazın" % CONFIRM_WORD)
            count = files.empty()
            return 200, {"purged": count}, count

        def save_text():
            parts = files.split(data.get("path"))
            return 200, files.save_text(parts, data.get("text"), data.get("encoding"), data.get("version")), "/".join(parts)

        def delete():
            # DD-235: tek öge adını, birden çok öge "onayla"yı yazarak onaylanır.
            parts, names = files.split(data.get("path")), self.names(data)
            want = names[0] if len(names) == 1 else CONFIRM_WORD
            got = str(data.get("confirm", ""))
            if (got if len(names) == 1 else got.strip().lower()) != want:
                raise PanelError(400, "onay için %s yazın" % ("ögenin adını" if len(names) == 1 else CONFIRM_WORD))
            deleted = files.delete(parts, names)
            return 200, {"deleted": deleted}, "%s %s" % ("/".join(parts), names[:5])

        if self.panel.system:
            routes = {
                "/api/mkdir": ("klasor", mkdir),
                "/api/rename": ("ad", rename),
                "/api/move": ("tasi", move),
                "/api/delete": ("sil", delete),
                "/api/text/save": ("duzenle", save_text),
            }
        else:
            routes = {
                "/api/mkdir": ("klasor", mkdir),
                "/api/rename": ("ad", rename),
                "/api/move": ("tasi", move),
                "/api/trash": ("cope", trash),
                "/api/trash/restore": ("geri-yukle", restore),
                "/api/trash/purge": ("kalici-sil", purge),
                "/api/trash/empty": ("cop-bosalt", empty),
                "/api/text/save": ("duzenle", save_text),
            }
        if route not in routes:
            self.error(404, "bulunamadı")
            return
        action, fn = routes[route]
        hint = " ".join(str(data.get(k))[:200] for k in ("path", "name", "names", "ids", "to") if k in data)
        self.run(user, action, fn, lock=True, hint=hint)


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 128


class SystemHandler(Handler):
    disable_nagle_algorithm = False  # Unix soketinde TCP_NODELAY yok


class UnixServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    """DD-235: sistem kipi yalnız Unix soketinde (0660 root:Caddy grubu); bağlananı çekirdeğin
    bildirdiği kimlik de sınırlar (master-panel'in sunucusuyla aynı kural, DD-180)."""
    daemon_threads = True
    request_queue_size = 128

    def __init__(self, path, handler, group_gid=None):
        self.group_gid = group_gid
        self.uids = {0, os.geteuid()}
        old = os.umask(0o177)
        try:
            super().__init__(path, handler)
        finally:
            os.umask(old)
        if group_gid is not None:
            os.chown(path, -1, group_gid)
            os.chmod(path, 0o660)

    def verify_request(self, request, client_address):
        if not hasattr(socket, "SO_PEERCRED"):
            return True
        size = struct.calcsize("3i")
        _pid, uid, gid = struct.unpack("3i", request.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, size))
        if uid in self.uids or (self.group_gid is not None and gid == self.group_gid):
            return True
        print("dosya: soket reddedildi (uid %d gid %d)" % (uid, gid), file=sys.stderr, flush=True)
        return False


def serve_system(args):
    """DD-235: master-sistem-dosya (root, /)."""
    kind, _, path = args.listen.partition(":")
    if kind != "unix" or not path.startswith("/") or len(path.encode()) > 100:
        fail("sistem görünümü yalnız bir Unix soketinde dinler (unix:/run/.../api.sock)")
    if not os.path.isabs(args.root):
        fail("kök mutlak yol olmalı")
    group_gid = None
    if args.socket_group:
        try:
            group_gid = grp.getgrnam(args.socket_group).gr_gid
        except KeyError:
            fail("soket grubu yok: %s" % args.socket_group)
    args.trash = args.share = args.archive_dir = args.downloads_dir = ""
    args.protected = []
    try:
        os.close(Files(args.root, "", system=True).open_dir([]))
    except OSError as err:
        fail("kök açılamadı: %s (%s)" % (args.root, os_message(err)))
    try:
        if stat.S_ISSOCK(os.lstat(path).st_mode):
            os.unlink(path)  # önceki çalışmadan kalan soket
    except FileNotFoundError:
        pass
    Handler.panel = Panel(args)
    httpd = UnixServer(path, SystemHandler, group_gid)
    print("sistem görünümü: %s dinleniyor (kök %s)" % (path, args.root), flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


def cmd_serve(args):
    if args.sistem:
        serve_system(args)
        return
    host, _, port = args.listen.rpartition(":")
    if host != "127.0.0.1" or not port.isdigit():
        fail("panel yalnız yerel adresi dinler (127.0.0.1:PORT)")
    if not os.path.isabs(args.root) or not TRASH_RE.match(args.trash):
        fail("kök mutlak yol, çöp adı noktayla başlayan küçük harfli bir ad olmalı")
    if args.share and (not TRASH_RE.match(args.share) or args.share == args.trash):
        fail("paylaşım klasörü adı noktayla başlayan küçük harfli ve çöpten farklı olmalı")
    if args.archive_dir and (not TRASH_RE.fullmatch(args.archive_dir) or args.archive_dir in (args.share, args.trash)):
        fail("arşiv çalışma klasörü noktayla başlayan küçük harfli ve diğer iç alanlardan farklı olmalı")
    # DD-203: paketlerin yazdığı klasörler (köke göre yol ve sahibinin adı); sayfa onları
    # seçtirmez, paylaştırmaz ve kime ait olduğunu söyler. Kurulum listeyi bildirimlerden derler.
    protected = []
    for entry in (args.protected or "").split(";"):
        if not entry.strip():
            continue
        rel, sep, owner = entry.partition("=")
        if not sep or not owner.strip() or not all(valid_name(p) for p in rel.split("/")):
            fail("geçersiz --protected")
        protected.append({"path": rel, "owner": owner.strip()})
    args.protected = protected
    try:
        Files(args.root, args.trash, args.share, args.archive_dir).split(args.downloads_dir)
    except PanelError:
        fail("geçersiz --downloads-dir")
    try:
        os.close(Files(args.root, args.trash, args.share).open_dir([]))
    except OSError as err:
        fail("kök açılamadı: %s (%s)" % (args.root, os_message(err)))
    Handler.panel = Panel(args)
    httpd = Server((host, int(port)), Handler)
    print("dosya paneli: %s:%s dinleniyor (kök %s)" % (host, port, args.root), flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(prog="master-files-panel")
    sub = parser.add_subparsers(dest="cmd")
    s = sub.add_parser("serve")
    s.add_argument("--listen", required=True)
    s.add_argument("--root", required=True)
    s.add_argument("--trash", default=".cop")
    s.add_argument("--share", default="")
    s.add_argument("--archive-dir", default="")
    s.add_argument("--domain", default="")
    s.add_argument("--version", default="")
    s.add_argument("--protected", default="")
    s.add_argument("--downloads-dir", default="")
    s.add_argument("--allow-host", dest="allow_host", action="append", default=[])
    s.add_argument("--sistem", action="store_true")
    s.add_argument("--socket-group", dest="socket_group", default="")
    c = sub.add_parser("check")
    c.add_argument("--url", required=True)
    c.add_argument("--host", required=True)
    args = parser.parse_args()
    if args.cmd == "serve":
        cmd_serve(args)
    elif args.cmd == "check":
        cmd_check(args)
    else:
        parser.print_usage()
        sys.exit(2)


if __name__ == "__main__":
    main()
