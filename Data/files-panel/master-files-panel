class DirFd:
    def __init__(self, fd):
        self.fd = fd

    def __enter__(self):
        return self.fd

    def __exit__(self, *exc):
        os.close(self.fd)


_renameat2 = None


def rename_noreplace(src_fd, src, dst_fd, dst):
    """src'yi dst'ye taşır; dst varsa FileExistsError. Dizin tanıtıcılarına göre, bağlantı izlemez."""
    global _renameat2
    if _renameat2 is None:
        try:
            fn = ctypes.CDLL(None, use_errno=True).renameat2
            fn.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
            fn.restype = ctypes.c_int
            _renameat2 = fn
        except (OSError, AttributeError):
            _renameat2 = False
    if _renameat2:
        if _renameat2(src_fd, os.fsencode(src), dst_fd, os.fsencode(dst), RENAME_NOREPLACE) == 0:
            return
        code = ctypes.get_errno()
        if code not in (errno.EINVAL, errno.ENOSYS):
            raise OSError(code, os.strerror(code))
    # Yedek yol: dosya sistemi RENAME_NOREPLACE bilmiyorsa (ya da testlerdeki macOS'ta)
    # önce hedefe bakılır. Aynı anda tek işlem yapıldığı için (panel kilidi) yeterli.
    try:
        os.stat(dst, dir_fd=dst_fd, follow_symlinks=False)
    except FileNotFoundError:
        os.rename(src, dst, src_dir_fd=src_fd, dst_dir_fd=dst_fd)
        return
    raise OSError(errno.EEXIST, os.strerror(errno.EEXIST))


def valid_name(name):
    if not isinstance(name, str) or name in ("", ".", "..") or "/" in name or "\x00" in name:
        return False
    try:
        return len(name.encode("utf-8")) <= 255
    except UnicodeEncodeError:
        return False


def numbered(name, i):
    dot = name.rfind(".")
    if dot > 0:
        return "%s (%d)%s" % (name[:dot], i, name[dot:])
    return "%s (%d)" % (name, i)


def dir_size(parent_fd, name, budget, dev=None):
    """dev verilirse (DD-248, sistem kipi) başka bir aygıttaki öge sayılmaz ve içine inilmez."""
    fd = os.open(name, O_DIR, dir_fd=parent_fd)
    total = 0
    try:
        with os.scandir(fd) as it:
            for entry in it:
                budget[0] -= 1
                if budget[0] < 0:
                    raise OverflowError("bütçe")
                try:
                    st = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                if dev is not None and st.st_dev != dev:
                    continue
                if stat.S_ISDIR(st.st_mode):
                    try:
                        total += dir_size(fd, entry.name, budget, dev)
                    except (OSError, RecursionError):
                        continue
                elif stat.S_ISREG(st.st_mode):
                    total += st.st_size
    finally:
        os.close(fd)
    return total


def rmtree_at(parent_fd, name):
    try:
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent_fd)
        return
    fd = os.open(name, O_DIR, dir_fd=parent_fd)
    try:
        with os.scandir(fd) as it:
            names = [e.name for e in it]
        for child in names:
            rmtree_at(fd, child)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def rmtree_onedev(parent_fd, name, dev):
    """DD-235: rmtree_at gibi, ama başka bir dosya sistemine (bağlama noktasına) inmez.
    Bağlama noktaları önceden denetlenir; bu, aradan geçen bir bağlamaya karşı son kilittir."""
    st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if st.st_dev != dev:
        raise OSError(errno.EXDEV, os.strerror(errno.EXDEV))
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent_fd)
        return
    fd = os.open(name, O_DIR, dir_fd=parent_fd)
    try:
        with os.scandir(fd) as it:
            names = [e.name for e in it]
        for child in names:
            rmtree_onedev(fd, child, dev)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def mount_points(mountinfo="/proc/self/mountinfo"):
    """Bağlı yolların listesi (mountinfo'nun 5. alanı; boşluk gibi karakterler \\ooo kaçışlı)."""
    points = []
    try:
        with open(mountinfo, encoding="utf-8", errors="surrogateescape") as fh:
            for line in fh:
                fields = line.split()
                if len(fields) > 4:
                    points.append(re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), fields[4]))
    except OSError:
        pass
    return points


def own_address(ip):
    """Sunucunun kendi adresi mi? (master-panel'deki denetimin aynısı, DD-180.)"""
    if ip.is_loopback or ip.is_link_local or ip.is_unspecified:
        return True
    try:
        with socket.socket(socket.AF_INET6 if ip.version == 6 else socket.AF_INET, socket.SOCK_STREAM) as probe:
            try:
                probe.setsockopt(socket.IPPROTO_IP, getattr(socket, "IP_BIND_ADDRESS_NO_PORT", 24), 1)
            except OSError:
                pass
            probe.bind((str(ip), 0))
    except OSError as err:
        return err.errno != errno.EADDRNOTAVAIL
    return True


def remote_tailnet(value):
    try:
        ip = ipaddress.ip_address(value)
    except ValueError:
        return False
    ip = getattr(ip, "ipv4_mapped", None) or ip
    return any(ip in net for net in TAILNET_RANGES) and not own_address(ip)


def read_json_at(dir_fd, name):
    try:
        fd = os.open(name, O_FILE, dir_fd=dir_fd)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            return None
        raw = fh.read(65537)
    try:
        data = json.loads(raw.decode("utf-8")) if len(raw) <= 65536 else None
    except (ValueError, UnicodeDecodeError, RecursionError):
        return None
    return data if isinstance(data, dict) else None


def write_json_at(dir_fd, name, obj):
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(4))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
                 0o600, dir_fd=dir_fd)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, ensure_ascii=False)
        os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise


def guess_encoding(data, name, truncated):
    try:
        data.decode("utf-8")
        valid = True
    except UnicodeDecodeError as err:
        # Kesilen dosyanın sonunda yarım kalmış çok baytlı karakter UTF-8'i bozmaz.
        valid = truncated and err.start >= len(data) - 3 and "end of data" in err.reason
    nfo = name.lower().endswith(".nfo")
    if valid and not (nfo and data.isascii()):
        return "utf-8"
    return "cp437" if nfo else "cp1254"


def local_devices(mountinfo="/proc/self/mountinfo"):
    """DD-248: yerel disk dosya sistemlerinin st_dev değerleri (mountinfo'nun maj:min alanı ve "-"
    ayıracından sonraki tür). Okunamazsa boş küme: hiçbir boyut taranmaz."""
    devices = set()
    try:
        with open(mountinfo, encoding="utf-8", errors="surrogateescape") as fh:
            for line in fh:
                fields = line.split()
                if "-" not in fields[6:]:
                    continue
                sep = fields.index("-", 6)
                major, _, minor = fields[2].partition(":")
                if sep + 1 < len(fields) and fields[sep + 1] in LOCAL_FS and major.isdigit() and minor.isdigit():
                    devices.add(os.makedev(int(major), int(minor)))
    except OSError:
        pass
    return devices


class Files:
    """Kök altındaki bütün işlemler. Yollar parça listesidir; kök []."""

    def __init__(self, root, trash, share="", archive="", system=False):
        self.root = root
        self.trash = trash
        self.share = share
        self.archive = archive
        # DD-235: root olarak / (çöp, arşiv ve ayrılmış ad yok; silme kalıcı).
        self.system = system
        self.dir_mode, self.file_mode = (0o755, 0o644) if system else (0o775, 0o664)
        self.lock = threading.Lock()

    # -- yollar
    def split(self, raw):
        if not isinstance(raw, str):
            raise PanelError(400, "geçersiz yol")
        raw = raw.strip("/")
        if not raw:
            return []
        parts = raw.split("/")
        if len(parts) > MAX_DEPTH or not all(valid_name(p) for p in parts):
            raise PanelError(400, "geçersiz yol")
        if self.trash and parts[0] == self.trash:
            raise PanelError(403, "çöpe yalnız Çöp sekmesinden erişilir")
        if self.share and parts[0] == self.share:
            raise PanelError(403, "eski paylaşım çalışma alanına erişilemez")
        if self.archive and parts[0] == self.archive:
            raise PanelError(403, "arşiv çalışma alanına erişilemez")
        return parts

    def check_new_name(self, parts, name):
        if not valid_name(name) or CONTROL_RE.search(name) or name != name.strip():
            raise PanelError(400, "geçersiz ad (boş olamaz, / içeremez, en çok 255 bayt)")
        if not parts and name in (self.trash, self.share, self.archive):
            raise PanelError(400, "bu ad sistem çalışma alanı için ayrılmış")

    def check_source_names(self, parts, names, destination=False):
        # Toplu işlem başlamadan hepsini denetle; reddedilen öge kısmi taşıma yaratmasın.
        for name in names:
            if not valid_name(name):
                raise PanelError(400, "geçersiz ad")
            if not parts and name in (self.trash, self.share, self.archive):
                raise PanelError(403, "kök klasöre sistem çalışma alanı adıyla taşınamaz" if destination
                                 else "sistem çalışma alanı taşınamaz veya yeniden adlandırılamaz")

    def open_dir(self, parts):
        fd = os.open(self.root, O_DIR)
        try:
            for part in parts:
                nxt = os.open(part, O_DIR, dir_fd=fd)
                os.close(fd)
                fd = nxt
        except BaseException:
            os.close(fd)
            raise
        return fd

    def trash_dir(self, create):
        with DirFd(self.open_dir([])) as root:
            if create:
                try:
                    os.mkdir(self.trash, 0o775, dir_fd=root)
                except FileExistsError:
                    pass
            return os.open(self.trash, O_DIR, dir_fd=root)

    # -- okuma
    def info(self, dir_fd, name, budget, sizes=True, local=None):
        """local verilirse (DD-248, sistem kipi) boyut yalnız o aygıtlardaki klasör için, kendi
        aygıtından çıkmadan taranır."""
        st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        item = {"name": name, "mtime": int(st.st_mtime), "size": None}
        if stat.S_ISDIR(st.st_mode):
            item["type"] = "dir"
            try:
                with DirFd(os.open(name, O_DIR, dir_fd=dir_fd)) as fd:
                    with os.scandir(fd) as it:
                        item["count"] = sum(1 for _ in it)
            except OSError:
                item["count"] = None
            if sizes and (local is None or st.st_dev in local):
                try:
                    item["size"] = dir_size(dir_fd, name, budget, None if local is None else st.st_dev)
                except (OSError, OverflowError, RecursionError):
                    item["size"] = None
        elif stat.S_ISREG(st.st_mode):
            item["type"] = "file"
            item["size"] = st.st_size
        else:
            item["type"] = "link" if stat.S_ISLNK(st.st_mode) else "other"
        return item

    def listing(self, parts, dirs_only):
        entries, skipped, budget = [], 0, [WALK_BUDGET]
        local = local_devices() if self.system and not dirs_only else None
        with DirFd(self.open_dir(parts)) as fd:
            with os.scandir(fd) as it:
                names = [e.name for e in it]
            for name in names:
                if not parts and name in (self.trash, self.share, self.archive):
                    continue
                if not valid_name(name):
                    skipped += 1
                    continue
                try:
                    item = self.info(fd, name, budget, sizes=not dirs_only, local=local)
                except OSError:
                    continue
                if not dirs_only or item["type"] == "dir":
                    entries.append(item)
        return {"path": "/".join(parts), "entries": entries, "skipped": skipped}

    def used(self):
        """Kökün toplam boyutu (çöp hariç); bütçe aşılırsa None."""
        total, budget = 0, [WALK_BUDGET]
        with DirFd(self.open_dir([])) as fd:
            with os.scandir(fd) as it:
                names = [e.name for e in it]
            for name in names:
                if name in (self.trash, self.share, self.archive) or not valid_name(name):
                    continue
                try:
                    st = os.stat(name, dir_fd=fd, follow_symlinks=False)
                    if stat.S_ISDIR(st.st_mode):
                        total += dir_size(fd, name, budget)
                    elif stat.S_ISREG(st.st_mode):
                        total += st.st_size
                except OverflowError:
                    return None
                except (OSError, RecursionError):
                    continue
        return total

    def trash_items(self):
        try:
            cop = self.trash_dir(create=False)
        except FileNotFoundError:
            return []
        items, budget = [], [WALK_BUDGET]
        with DirFd(cop):
            with os.scandir(cop) as it:
                tokens = [e.name for e in it if TOKEN_RE.match(e.name) and e.is_dir(follow_symlinks=False)]
            for token in tokens:
                meta = read_json_at(cop, token + ".json") or {}
                try:
                    with DirFd(os.open(token, O_DIR, dir_fd=cop)) as tfd:
                        with os.scandir(tfd) as it:
                            names = [e.name for e in it]
                        if len(names) == 1 and valid_name(names[0]):
                            item = self.info(tfd, names[0], budget)
                        else:
                            item = {"name": "(bozuk kayıt)", "type": "other", "size": None, "broken": True,
                                    "mtime": int(token[:13]) // 1000}
                except OSError:
                    continue
                origin = meta.get("from")
                try:
                    origin = "/".join(self.split(origin)) if isinstance(origin, str) else None
                except PanelError:
                    origin = None
                deleted = meta.get("deleted")
                item.update({"id": token, "from": origin,
                             "deleted": deleted if isinstance(deleted, int) else int(token[:13]) // 1000})
                items.append(item)
        items.sort(key=lambda i: i["id"], reverse=True)
        return items

    def open_file(self, parts):
        if not parts:
            raise PanelError(400, "dosya değil")
        with DirFd(self.open_dir(parts[:-1])) as dfd:
            fd = os.open(parts[-1], O_FILE, dir_fd=dfd)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            os.close(fd)
            raise PanelError(400, "dosya değil")
        return fd, st

    def text(self, parts, enc):
        if enc not in ("auto", "") and enc not in ENCODINGS:
            raise PanelError(400, "geçersiz kodlama")
        fd, st = self.open_file(parts)
        with os.fdopen(fd, "rb") as fh:
            data = fh.read(TEXT_LIMIT)
        truncated = st.st_size > len(data)
        if b"\x00" in data[:SNIFF_BYTES]:
            raise PanelError(415, "metin dosyası değil")
        detected = guess_encoding(data, parts[-1], truncated)
        chosen = detected if enc in ("auto", "") else enc
        # DD-249: düzenlenebilirse sürümü (baytların SHA-256'sı) kayıtta geri gelir; değilse nedeni yazılır.
        reason = "" if truncated else self.edit_refusal(st)
        if not reason and not truncated:
            try:
                data.decode(ENCODINGS[chosen])
            except UnicodeDecodeError:
                reason = "bu kodlamayla kayıpsız okunamıyor; başka bir kodlama seçin"
        elif truncated:
            reason = "dosya 1 MiB'tan büyük; yalnız ilk bölümü okunur"
        return {"path": "/".join(parts), "size": st.st_size, "mtime": int(st.st_mtime),
                "truncated": truncated, "detected": detected, "encoding": chosen,
                "bom": data.startswith(codecs.BOM_UTF8), "eol": "crlf" if b"\r\n" in data else "lf",
                "editable": not reason, "reason": reason,
                "version": None if reason else hashlib.sha256(data).hexdigest(),
                "text": data.decode(ENCODINGS[chosen], errors="replace")}

    def edit_refusal(self, st):
        """DD-249: bu dosya düzenleyiciyle kaydedilemezse nedeni; kaydedilebilirse boş."""
        if st.st_nlink > 1:
            return "dosyanın birden çok sabit bağlantısı var; düzenlenmez"
        if st.st_mode & (stat.S_ISUID | stat.S_ISGID):
            return "setuid/setgid dosya düzenlenmez"
        # /srv görünümü indirme hesabıdır: başkasının dosyasını sahibini koruyarak yeniden yazamaz.
        if not self.system and st.st_uid != os.geteuid():
            return "dosyanın sahibi başka bir hesap; düzenlenemez"
        return ""

    def save_text(self, parts, text, enc, version):
        """DD-249: düzenleyicinin kaydı (çağıran self.lock'u tutar). Dosyanın sürümü açıldığındakiyle
        aynı olmalıdır. Metin aynı kodlamayla (UTF-8 BOM'u korunur) ve aynı satır sonlarıyla yazılır:
        önce aynı klasörde geçici bir dosyaya, eskisinin sahibi, grubu, izinleri ve ek öznitelikleriyle,
        diske işlenir, sonra eskisinin yerine konur. Yarıda kalan bir kayıt dosyayı bozmaz."""
        if enc not in ENCODINGS:
            raise PanelError(400, "geçersiz kodlama")
        if not isinstance(text, str) or not isinstance(version, str) or not VERSION_RE.match(version):
            raise PanelError(400, "geçersiz kayıt")
        if not parts:
            raise PanelError(400, "dosya değil")
        name = parts[-1]
        with DirFd(self.open_dir(parts[:-1])) as dfd, DirFd(os.open(name, O_FILE, dir_fd=dfd)) as fd:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                raise PanelError(400, "dosya değil")
            data = os.pread(fd, TEXT_LIMIT + 1, 0)
            if len(data) > TEXT_LIMIT or st.st_size > TEXT_LIMIT:
                raise PanelError(413, "dosya 1 MiB'tan büyük; düzenlenmez")
            reason = self.edit_refusal(st)
            if reason:
                raise PanelError(403, reason)
            if hashlib.sha256(data).hexdigest() != version:
                raise PanelError(409, "dosya siz açtıktan sonra değişti; kaydedilmedi (yeniden açın)")
            codec = "utf-8-sig" if enc == "utf-8" and data.startswith(codecs.BOM_UTF8) else "utf-8" if enc == "utf-8" else ENCODINGS[enc]
            try:
                raw = text.replace("\r\n", "\n").replace("\r", "\n").encode(codec)
            except UnicodeEncodeError as err:
                raise PanelError(400, "“%s” bu kodlamada yok; kaydedilmedi" % err.object[err.start:err.end][:8])
            if b"\r\n" in data:
                raw = raw.replace(b"\n", b"\r\n")
            if len(raw) > TEXT_LIMIT:
                raise PanelError(413, "metin 1 MiB'tan büyük; kaydedilmedi")
            tmp = ".konsol-kayit-%s" % secrets.token_hex(8)
            tfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), 0o600, dir_fd=dfd)
            try:
                try:
                    os.fchown(tfd, st.st_uid, st.st_gid)
                    os.fchmod(tfd, stat.S_IMODE(st.st_mode))
                    try:
                        attrs = os.listxattr(fd)
                    except OSError as err:
                        if err.errno not in (errno.ENOTSUP, errno.EOPNOTSUPP):
                            raise
                        attrs = []
                    for attr in attrs:
                        os.setxattr(tfd, attr, os.getxattr(fd, attr))
                    view = memoryview(raw)
                    while view:
                        view = view[os.write(tfd, view):]
                    os.fsync(tfd)
                finally:
                    os.close(tfd)
                # Arada dosya değiştirildiyse ya da yerine başka bir şey konduysa kayıt yapılmaz.
                now = os.stat(name, dir_fd=dfd, follow_symlinks=False)
                if (now.st_dev, now.st_ino, now.st_mtime_ns, now.st_size) != (st.st_dev, st.st_ino, st.st_mtime_ns, st.st_size):
                    raise PanelError(409, "dosya siz açtıktan sonra değişti; kaydedilmedi (yeniden açın)")
                os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
            except BaseException:
                try:
                    os.unlink(tmp, dir_fd=dfd)
                except OSError:
                    pass
                raise
            os.fsync(dfd)
            new = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        return {"path": "/".join(parts), "version": hashlib.sha256(raw).hexdigest(), "size": len(raw),
                "mtime": int(new.st_mtime)}

    # -- değişiklik (çağıran self.lock'u tutar)
    def mkdir(self, parts, name):
        self.check_new_name(parts, name)
        with DirFd(self.open_dir(parts)) as fd:
            os.mkdir(name, self.dir_mode, dir_fd=fd)

    def rename(self, parts, name, new):
        self.check_source_names(parts, [name])
        self.check_new_name(parts, new)
        if name == new:
            return
        with DirFd(self.open_dir(parts)) as fd:
            rename_noreplace(fd, name, fd, new)

    def move(self, parts, names, dest):
        self.check_source_names(parts, names)
        self.check_source_names(dest, names, destination=True)
        if dest == parts:
            raise PanelError(400, "seçilenler zaten bu klasörde")
        for name in names:
            if dest[:len(parts) + 1] == parts + [name]:
                raise PanelError(400, "bir klasör kendi içine taşınamaz")
        moved = []
        with DirFd(self.open_dir(parts)) as sfd, DirFd(self.open_dir(dest)) as dfd:
            for name in names:
                try:
                    os.stat(name, dir_fd=dfd, follow_symlinks=False)
                except FileNotFoundError:
                    continue
                raise PanelError(409, "“%s” hedefte zaten var; üzerine yazılmaz" % name)
            for name in names:
                try:
                    rename_noreplace(sfd, name, dfd, name)
                except OSError as err:
                    if not moved:
                        raise
                    raise PanelError(status_for(err), "%d öge taşındı; “%s” taşınamadı: %s"
                                     % (len(moved), name, os_message(err)))
                moved.append(name)
        return moved

    def upload_check(self, parts, name, length=0):
        """Gövde okunmadan önceki denetimler: geçerli ad, var olan klasör, boş hedef, boş alan."""
        self.check_new_name(parts, name)
        with DirFd(self.open_dir(parts)) as fd:
            try:
                os.stat(name, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                disk_room(fd, length)
                return
        raise PanelError(409, "“%s” zaten var; üzerine yazılmaz" % name)

    def upload(self, parts, name, stream, length):
        """Akışı <parts>/<name> olarak yazar. Geçici ada yazılır, bitince atomik taşınır:
        yarım kalan dosya listeye hiç girmez, var olanın üzerine yazılmaz (DD-145)."""
        self.upload_check(parts, name, length)
        tmp = ".yukleniyor-%s" % secrets.token_hex(6)
        written = since = 0
        with DirFd(self.open_dir(parts)) as fd:
            handle = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, self.file_mode, dir_fd=fd)
            try:
                # umask ne olursa olsun ağacın kuralı: dosya 0664 (indirme hesabının servisleri aynı grupla
                # yazar; Paylaşım aynı hesapla okur; ensure_downloads_tree de bunu bekler). DD-235: sistem
                # kipinde root'un dosyası 0644.
                os.fchmod(handle, self.file_mode)
                while written < length:
                    chunk = stream.read(min(UPLOAD_CHUNK, length - written))
                    if not chunk:
                        raise PanelError(400, "yükleme yarıda kesildi")
                    os.write(handle, chunk)
                    written += len(chunk)
                    since += len(chunk)
                    if since >= DISK_CHECK_EVERY:
                        since = 0
                        disk_room(fd)
                os.fsync(handle)
            except BaseException:
                os.close(handle)
                try:
                    os.unlink(tmp, dir_fd=fd)
                except OSError:
                    pass
                raise
            os.close(handle)
            try:
                # Akış kilitsiz sürer (saatlerce sürebilir); yalnız son adım kilitli:
                # ad çakışmasına bakan yedek rename yolu için yeterli.
                with self.lock:
                    rename_noreplace(fd, tmp, fd, name)
            except BaseException:
                try:
                    os.unlink(tmp, dir_fd=fd)
                except OSError:
                    pass
                raise
        return written

    def delete(self, parts, names, mounts=None):
        """DD-235: sistem kipinde kalıcı silme (çöp yok: / altındaki diskler farklı olabilir).
        Bağlama noktası ya da altında bağlı bir şey olan öge silinmez; önce hepsi denetlenir."""
        self.check_source_names(parts, names)
        mounts = mount_points() if mounts is None else mounts
        base = os.path.join(self.root, *parts) if parts else self.root
        for name in names:
            target = os.path.normpath(os.path.join(base, name))
            if any(m == target or m.startswith(target.rstrip("/") + "/") for m in mounts):
                raise PanelError(409, "“%s” bir bağlama noktası ya da içinde bağlı bir disk var; silinmez" % name)
        done = []
        with DirFd(self.open_dir(parts)) as fd:
            dev = os.fstat(fd).st_dev
            for name in names:
                try:
                    rmtree_onedev(fd, name, dev)
                except OSError as err:
                    if not done:
                        raise
                    raise PanelError(status_for(err), "%d öge silindi; “%s” silinemedi: %s"
                                     % (len(done), name, os_message(err)))
                done.append(name)
        return done

    def to_trash(self, parts, names):
        self.check_source_names(parts, names)
        ids = []
        with DirFd(self.open_dir(parts)) as sfd, DirFd(self.trash_dir(create=True)) as cop:
            for name in names:
                token = "%013d-%s" % (int(time.time() * 1000), secrets.token_hex(4))
                os.mkdir(token, 0o775, dir_fd=cop)
                try:
                    write_json_at(cop, token + ".json", {"from": "/".join(parts), "name": name,
                                                         "deleted": int(time.time())})
                    with DirFd(os.open(token, O_DIR, dir_fd=cop)) as tfd:
                        rename_noreplace(sfd, name, tfd, name)
                except BaseException as err:
                    for undo in (lambda: os.unlink(token + ".json", dir_fd=cop), lambda: os.rmdir(token, dir_fd=cop)):
                        try:
                            undo()
                        except OSError:
                            pass
                    if ids and isinstance(err, OSError):
                        raise PanelError(status_for(err), "%d öge çöpe taşındı; “%s” taşınamadı: %s"
                                         % (len(ids), name, os_message(err)))
                    raise
                ids.append(token)
        return ids

    def restore(self, ids):
        done = []
        with DirFd(self.trash_dir(create=False)) as cop:
            for token in ids:
                meta = read_json_at(cop, token + ".json") or {}
                with DirFd(os.open(token, O_DIR, dir_fd=cop)) as tfd:
                    with os.scandir(tfd) as it:
                        names = [e.name for e in it]
                    if len(names) != 1 or not valid_name(names[0]):
                        raise PanelError(400, "çöp kaydı bozuk; kalıcı silin")
                    dest = []
                    try:
                        if isinstance(meta.get("from"), str):
                            dest = self.split(meta["from"])
                        dfd = self.open_dir(dest)
                    except (PanelError, OSError):
                        dest = []
                        dfd = self.open_dir([])
                    with DirFd(dfd):
                        final = self.place(tfd, names[0], dfd, dest)
                os.rmdir(token, dir_fd=cop)
                try:
                    os.unlink(token + ".json", dir_fd=cop)
                except FileNotFoundError:
                    pass
                done.append({"id": token, "path": "/".join(dest), "name": final})
        return done

    def place(self, src_fd, name, dst_fd, dest):
        candidate = name
        for i in range(2, 102):
            if dest or candidate not in (self.trash, self.share, self.archive):
                try:
                    rename_noreplace(src_fd, name, dst_fd, candidate)
                    return candidate
                except FileExistsError:
                    pass
            candidate = numbered(name, i)
        raise PanelError(409, "geri yüklemek için boş bir ad bulunamadı")

    def purge(self, ids):
        with DirFd(self.trash_dir(create=False)) as cop:
            for token in ids:
                rmtree_at(cop, token)
                try:
                    os.unlink(token + ".json", dir_fd=cop)
                except FileNotFoundError:
                    pass

    def empty(self):
        try:
            cop = self.trash_dir(create=False)
        except FileNotFoundError:
            return 0
        with DirFd(cop):
            with os.scandir(cop) as it:
                names = [e.name for e in it]
            for name in names:
                rmtree_at(cop, name)
        return sum(1 for n in names if TOKEN_RE.match(n))


def os_message(err):
    return {
        errno.ENOENT: "bulunamadı (taşınmış ya da silinmiş olabilir)",
        errno.EEXIST: "aynı adla bir öge var; üzerine yazılmaz",
        errno.ENOTEMPTY: "aynı adla bir öge var; üzerine yazılmaz",
        errno.ENOTDIR: "klasör değil",
        errno.ELOOP: "sembolik bağlantı izlenmez",
        errno.EACCES: "izin yok",
        errno.EPERM: "izin yok",
        errno.EXDEV: "farklı bir diske taşınamaz",
        errno.EINVAL: "bir klasör kendi içine taşınamaz",
        errno.ENOSPC: "diskte yer yok",
        errno.EROFS: "dosya sistemi salt okunur",
        errno.ENAMETOOLONG: "ad çok uzun",
        errno.EBUSY: "öge kullanımda",
    }.get(err.errno, "işlem yapılamadı (%s)" % errno.errorcode.get(err.errno, err.errno))


def status_for(err):
    if err.errno == errno.ENOENT:
        return 404
    if err.errno in (errno.EEXIST, errno.ENOTEMPTY):
        return 409
    if err.errno in (errno.EACCES, errno.EPERM):
        return 403
    return 400


