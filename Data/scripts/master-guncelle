#!/usr/bin/env bash
# DD-233: Konsol'daki "Güncelle" düğmesinin işi (root). Konsol bunu kendi biriminde başlatır:
#   master-guncelle uygula <commit> <sürüm>
# O commit'teki kur.sh'ı indirir ve güncelleme kipinde çalıştırır (KUR_REF=<commit>,
# KUR_GUNCELLE=<sürüm>): kod atomik yerleşir, install.sh terminalsiz yeniden koşar. Sonuç
# GUNCELLEME_DURUM_FILE'a, çıktı GUNCELLEME_LOG_FILE'a (ve birimin günlüğüne) yazılır.
set -Eeuo pipefail
umask 077

STATE_FILE="${STATE_FILE:-/etc/master-stack/state.env}"

state_get() {
    local line
    line="$(grep -m1 -E "^$1=" "$STATE_FILE" 2>/dev/null)" || return 1
    printf '%s' "${line#*=}"
}

fail() { echo "HATA: $*" >&2; exit 1; }

write_status() {
    # key=value satırları; yarım dosya okunmasın diye yeni dosya yerine taşınır.
    local tmp="$status_file.$$"
    printf '%s\n' "$@" >"$tmp"
    chmod 0644 "$tmp"
    mv -f -- "$tmp" "$status_file"
}

[[ "$(id -u)" -eq 0 ]] || fail "root gerekli"
[[ "${1:-}" == "uygula" && $# -eq 3 ]] || fail "kullanım: master-guncelle uygula <commit> <sürüm>"
commit="$2" version="$3"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail "geçersiz commit: $commit"
[[ "$version" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}-v2-[0-9]+$ ]] || fail "geçersiz sürüm: $version"
repo="$(state_get GUNCELLEME_REPO)" || fail "state.env'de GUNCELLEME_REPO yok"
status_file="$(state_get GUNCELLEME_DURUM_FILE)" || fail "state.env'de GUNCELLEME_DURUM_FILE yok"
log_file="$(state_get GUNCELLEME_LOG_FILE)" || fail "state.env'de GUNCELLEME_LOG_FILE yok"
[[ "$repo" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || fail "geçersiz depo: $repo"
mkdir -p -- "${status_file%/*}" "${log_file%/*}"

started="$(date +%s)"
write_status durum=calisiyor "hedef=$version" "commit=$commit" "baslangic=$started"
: >"$log_file"
chmod 0600 "$log_file"

tmp="$(mktemp -d /tmp/master-guncelle.XXXXXX)"
trap 'rm -rf -- "$tmp"' EXIT
rc=0
{
    echo "==> $repo@$commit ($version) indiriliyor"
    # KUR_BETIK_URL yalnız testler içindir.
    curl -fsSL --proto '=https,file' --retry 3 --max-time 120 -o "$tmp/kur.sh" \
        "${KUR_BETIK_URL:-https://raw.githubusercontent.com/$repo/$commit/kur.sh}" &&
        KUR_REF="$commit" KUR_GUNCELLE="$version" bash "$tmp/kur.sh"
} 2>&1 | tee -a "$log_file" || rc=$?

if [[ "$rc" -eq 0 ]]; then
    write_status durum=tamam "hedef=$version" "commit=$commit" "baslangic=$started" "bitis=$(date +%s)"
else
    # Operatöre çıktının son satırı gösterilir: kur.sh'ın "HATA:" satırı ya da kurulumun die
    # iletisi (saat öneki ve "HATA:" atılır).
    message="$(grep -v '^[[:space:]]*$' "$log_file" | tail -n1 || true)"
    message="${message#\[*\] }"
    message="${message#HATA: }"
    message="$(printf '%s' "${message:-çıkış kodu $rc}" | tr -d '\r\n' | cut -c1-280)"
    write_status durum=hata "hedef=$version" "commit=$commit" "baslangic=$started" "bitis=$(date +%s)" "mesaj=$message"
fi
exit "$rc"
